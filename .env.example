# App
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wellconsult
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# AWS S3 (document & record storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=wellconsult-docs

# Razorpay
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Firebase (push notifications)
FIREBASE_PROJECT_ID=wellconsult
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@wellconsult.iam.gserviceaccount.com

# Email (Nodemailer / SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=noreply@wellconsult.in

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE=+1234567890

# Daily.co (video sessions)
DAILY_API_KEY=your_daily_api_key
DAILY_DOMAIN=wellconsult

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://wellconsult.in

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
